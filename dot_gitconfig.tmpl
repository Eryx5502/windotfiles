# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
name = {{ .git.name }}
email = {{ .git.email }}
[credential]
	useHttpPath = {{ .git.useHttpPath }}
{{- with .git.gcmProvider }}
	provider = {{ . }}
{{- end }}
	autoDetectTimeout = -1
{{ if .git.internalHost -}}
[credential "https://{{ .git.internalHost }}"]
	usehttppath = false
{{ end -}}
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[core]
	editor = nvim
	pager = delta
{{- with .git.sshCommand }}
	sshCommand = {{ . }}
{{- end }}
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = diff3
