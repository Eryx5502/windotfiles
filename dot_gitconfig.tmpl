# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
name = Aitor Balmaseda
email = abalmaseda@innomerics.com
[credential]
	useHttpPath = true
	provider = generic
	autoDetectTimeout = -1
{{ if .git.internalHost -}}
[credential "https://{{ .git.internalHost }}"]
	usehttppath = false
{{ end -}}
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = diff3
