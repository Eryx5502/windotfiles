{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.28/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.yaml",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 5,
  "default_container_padding": 5,
  "border": false,
  "border_width": 2,
  "border_offset": -1,
  "border_colours": {
    "single": "#42a5f5",
    "stack": "#00a542",
    "monocle": "#ff3399",
    "unfocused": "#808080"
  },
  "stackbar": {
    "height": 40,
    "mode": "OnStack",
    "tabs": {
      "width": 300,
      "focused_text": "#00a542",
      "unfocused_text": "#b3b3b3",
      "background": "#141414"
    }
  },
  "float_rules": [
    {
      "id": "MozillaDialogClass",
      "kind": "Class"
    }
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "general",
          "layout": "BSP"
        },
        {
          "name": "web",
          "layout": "BSP",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "firefox.exe"
            }
          ]
        },
        {
          "name": "code",
          "layout": "RightMainVerticalStack"
        },
        {
          "name": "comunicaciones",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "thunderbird.exe"
            }
          ],
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "Telegram.exe"
            },
            {
              "kind": "Title",
              "id": "WhatsApp"
            }
          ]
        },
        {
          "name": "multi",
          "layout": "BSP",
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "Spotify.exe"
            },
            {
              "kind": "Exe",
              "id": "Discord.exe"
            }
          ]
        },
        {
          "name": "VI",
          "layout": "Grid"
        }
      ]
    }
  ]
}
